# Copy to .env. Never commit real credentials.
RAG_STORE_BACKEND=sqlite
RAG_SQLITE_PATH=data/rag.sqlite3
RAG_KNOWLEDGE_BASES_FILE=knowledge_bases.json
RAG_DEFAULT_KNOWLEDGE_BASE=local

# Key-free local proof of concept. Hash vectors are NOT semantic.
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_DIMENSIONS=128
# For any OpenAI-compatible embeddings endpoint:
# RAG_EMBEDDING_PROVIDER=openai_compatible
# RAG_EMBEDDING_BASE_URL=https://api.example.com/v1
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_MODEL=provider/embedding-model
# RAG_EMBEDDING_DIMENSIONS=1536
# Set false for providers/models that reject the dimensions argument.
# RAG_EMBEDDING_SEND_DIMENSIONS=false

# LLM response generation is optional, and defaults to disabled.
RAG_LLM_PROVIDER=disabled
# RAG_LLM_PROVIDER=openai_compatible
# RAG_LLM_BASE_URL=https://api.example.com/v1
# RAG_LLM_API_KEY=
# RAG_LLM_MODEL=provider/model-name
# RAG_LLM_TEMPERATURE=0
# RAG_LLM_MAX_TOKENS=512
# RAG_LLM_TIMEOUT_SECONDS=45

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_DOCUMENT_BYTES=1048576
RAG_MAX_SOURCE_BYTES=10485760
RAG_MAX_PDF_PAGES=40
RAG_OCR_LANGUAGE=eng

# Future cloud sources (optional for local POC):
# RAG_GOOGLE_SERVICE_ACCOUNT_FILE=/secure/path/service-account.json
# RAG_NOTION_TOKEN=

# Telegram (optional; webhook disabled until BOTH values are set).
# Configure these as Vercel encrypted/sensitive project environment variables.
# Do not commit actual values or paste them into chat.
# RAG_TELEGRAM_BOT_TOKEN=
# RAG_TELEGRAM_CHAT_ID=
# Vercel demo uses RAG_DEFAULT_KNOWLEDGE_BASE=tayoca
