# Copy to .env. This example contains NO secrets.
RAG_STORE_BACKEND=sqlite
RAG_SQLITE_PATH=data/rag.sqlite3
RAG_KNOWLEDGE_BASES_FILE=knowledge_bases.json
RAG_DEFAULT_KNOWLEDGE_BASE=local
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_DIMENSIONS=128
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_DOCUMENT_BYTES=1048576
RAG_MAX_SOURCE_BYTES=10485760
RAG_MAX_PDF_PAGES=40
RAG_OCR_LANGUAGE=eng
# Optional real semantic embeddings:
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_DIMENSIONS=1536
# RAG_OPENAI_API_KEY=
# RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Cloud connector credentials (leave empty for local POC):
# RAG_GOOGLE_SERVICE_ACCOUNT_FILE=/secure/path/service-account.json
# RAG_NOTION_TOKEN=
